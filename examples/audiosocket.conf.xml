<!-- mod_audiosocket settings that apply to every call. Save as autoload_configs/audiosocket.conf.xml,
     then run audiosocket_reload in fs_cli. The file is optional: without it the built-in defaults below
     are used. A channel variable set in the dialplan before the audiosocket app overrides the matching
     setting for that call, and calls already running keep the values they started with.
     Values that are not acceptable are logged as warnings and the default is kept. -->
<configuration name="audiosocket.conf" description="mod_audiosocket">
  <settings>
    <!-- Sample rate of the audio exchanged with the server: 8000, 12000, 16000, 24000, 32000, 44100,
         48000, 96000 or 192000. Channel variable: audiosocket_rate, or the app's third argument. -->
    <param name="default-rate" value="8000"/>

    <!-- How long to wait for the TCP connection, in ms (1 to 60000). Channel variable: audiosocket_connect_timeout_ms -->
    <param name="connect-timeout-ms" value="2000"/>

    <!-- Audio held before the server's audio starts playing, and again after it runs dry, in ms (20 to 10000).
         More hides a bursty server, less lowers the delay. Channel variable: audiosocket_jitter_ms -->
    <param name="jitter-buffer-ms" value="200"/>

    <!-- Most server audio kept waiting to play, in ms (100 to 60000). Large on purpose: a bot may send speech
         faster than real time. Channel variable: audiosocket_max_queue_ms -->
    <param name="max-queue-ms" value="10000"/>

    <!-- Audio queued for a server that reads slowly before frames are dropped, in ms (100 to 10000). -->
    <param name="send-queue-ms" value="500"/>

    <!-- Give up on a server that is connected but accepts no data for this long, in ms (0 to 600000, 0 = never).
         The call then moves on and audiosocket_status is server_stalled. Channel variable: audiosocket_stall_timeout_ms -->
    <param name="stall-timeout-ms" value="10000"/>

    <!-- Send the caller's key presses to the server as DTMF frames: true or false.
         Channel variable: audiosocket_dtmf -->
    <param name="dtmf" value="true"/>

    <!-- Channel variables to send once to the server, as JSON, in a metadata frame (kind 0x40) right after the
         UUID frame. Empty means none. Leave this empty unless your server understands the frame.
         Never list variables that hold secrets: the connection is plain TCP.
         Channel variable: audiosocket_send_vars (the value none turns it off for one call) -->
    <param name="send-vars" value=""/>
  </settings>
</configuration>
